# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Generated test fixtures and run logs
**/tests/fixtures/
*.log

# Sequence and alignment data
*.fa
*.fasta
*.fa.gz
*.fasta.gz
*.fq
*.fastq
*.fq.gz
*.fastq.gz
*.gb
*.gbk
*.sam
*.bam
*.bam.bai
*.cram
*.crai
*.vcf
*.vcf.gz
*.h5ad
*.loom

# samtools depth output, anywhere
depth_*.txt

# Pipeline and provider outputs from the vector-integration workflow
skills/vector-integration-analysis/**/*.tsv
skills/vector-integration-analysis/**/identity*.json
skills/vector-integration-analysis/**/accounting*.json
skills/vector-integration-analysis/**/loci*.tsv
skills/vector-integration-analysis/**/junctions*.tsv

# Keep committed examples, templates and styles
!skills/*/assets/**
!skills/*/references/**

# ...and committed test inputs and golden outputs. Without this, a checked-in
# fixture is silently unaddable: tests/fixtures/ above, *.fa, and the
# skill-specific **/*.tsv rules each swallow one, and `git add` is a no-op that
# stages nothing. A regression test needs a known-truth input it can commit.
!skills/*/tests/**

# A negation outranks the earlier __pycache__/ and *.py[cod] rules, so re-ignore
# build junk under the directories just re-included. Otherwise a stray .pyc
# under any skill's assets/ or tests/ is committable and churns on every Python
# minor-version bump.
skills/*/assets/**/__pycache__/
skills/*/tests/**/__pycache__/
skills/*/assets/**/*.py[cod]
skills/*/tests/**/*.py[cod]

# Model caches (download on demand, don't commit)
skills/immunoinformatics/models/
skills/esm/models/

# Credentials
.env
*.pem
*.key
credentials*
secrets*

# Specialists export
specialists-export.yaml
